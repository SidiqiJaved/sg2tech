# Public canonical origin, no trailing slash. Used for canonical URLs, sitemap and Open Graph.
# Leave as the staging value until the production domain is approved.
VITE_SITE_URL=https://www.sg2tech.com

# Set to "true" on Netlify once the site is deployed and the "contact" form appears in the
# Netlify dashboard. Leave unset locally: the form will then say plainly that it is not connected.
VITE_FORMS_ENABLED=

# Set to "true" on staging/preview deploys: adds noindex and a Disallow-all robots.txt.
# Leave unset for production.
VITE_NOINDEX=
